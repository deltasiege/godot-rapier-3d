      "link": null,
      "locked": false,
      "text": "# LocalPeer\n\n- metadata: PeerMetadata\n- buffers: PeerBuffers\n\n- input_adapter: Option<Gd<GR3DInputAdapter>>\n- world_buffer: HashMap<tick, ser_world_snapshot (Vec<u8>) >\n\n---\n\nfn record_world_snapshot( WorldSnapshot ):\n    append the given WorldSnapshot to the world_buffer\n    update the world_hashes buffer too",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# LocalPeer\n\n- metadata: PeerMetadata\n- buffers: PeerBuffers\n\n- input_adapter: Option<Gd<GR3DInputAdapter>>\n- world_buffer: HashMap<tick, ser_world_snapshot (Vec<u8>) >\n\n---\n\nfn record_world_snapshot( WorldSnapshot ):\n    append the given WorldSnapshot to the world_buffer\n    update the world_hashes buffer too",
      "autoResize": true,
      "lineHeight": 1.25
    },
